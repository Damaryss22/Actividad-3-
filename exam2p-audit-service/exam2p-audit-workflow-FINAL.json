{
  "name": "exam2p-audit-workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "exam2p-audit-deletion",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-audit",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "exam2p-audit-deletion"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body?.data?.exam2p_action || '' }}",
              "operation": "equals",
              "value2": "DELETE"
            }
          ]
        }
      },
      "id": "if-delete",
      "name": "IF",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:4000/gemini/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": \"Se eliminó un registro en la entidad {{ $json.body.data.exam2p_entity }}. Usuario: {{ $json.body.data.exam2p_user }}. Genera un breve reporte de auditoría profesional (máximo 100 palabras).\"\n}",
        "options": {}
      },
      "id": "gemini-request",
      "name": "Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "msg-ia",
              "name": "mensaje_ia",
              "type": "string",
              "value": "={{ $json.message || 'Reporte generado' }}"
            },
            {
              "id": "entity",
              "name": "entidad",
              "type": "string",
              "value": "={{ $('Webhook').first().json.body.data.exam2p_entity }}"
            },
            {
              "id": "user",
              "name": "usuario",
              "type": "string",
              "value": "={{ $('Webhook').first().json.body.data.exam2p_user }}"
            },
            {
              "id": "action",
              "name": "accion",
              "type": "string",
              "value": "={{ $('Webhook').first().json.body.data.exam2p_action }}"
            }
          ]
        },
        "options": {}
      },
      "id": "combinar-datos",
      "name": "Combinar Datos",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [600, 0]
    },
    {
      "parameters": {
        "chatId": "TU_CHAT_ID",
        "text": "=🚨 *Auditoría del Sistema*\n\n{{ $json.mensaje_ia }}\n\n📋 *Detalles:*\n• Entidad: {{ $json.entidad }}\n• Acción: {{ $json.accion }}\n• Usuario: {{ $json.usuario }}\n• Timestamp: {{ $now }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-notify",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [800, 0],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Evento exam2p.audit.deletion procesado correctamente\",\n  \"timestamp\": \"{{ $now }}\"\n}",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1000, 0]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{"node": "IF", "type": "main", "index": 0}]]
    },
    "IF": {
      "main": [
        [{"node": "Gemini", "type": "main", "index": 0}],
        [{"node": "Respond to Webhook", "type": "main", "index": 0}]
      ]
    },
    "Gemini": {
      "main": [[{"node": "Combinar Datos", "type": "main", "index": 0}]]
    },
    "Combinar Datos": {
      "main": [[{"node": "Telegram", "type": "main", "index": 0}]]
    },
    "Telegram": {
      "main": [[{"node": "Respond to Webhook", "type": "main", "index": 0}]]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "exam2p-v1"
}
