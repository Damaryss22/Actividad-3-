{
  "compilerOptions": {
    // Layout de archivos
    "outDir": "./dist",
    "rootDir": "./src",

    // Opciones del entorno
    "module": "commonjs",
    "target": "es6",
    "lib": ["es6"],
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    // Mejoras de desarrollo
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
